# Copy to .env and fill in. Never commit .env.
DB_PASSWORD=change-me-strong-db-password
# At least 32 random characters, e.g.  openssl rand -base64 48
JWT_SECRET=
# First HR administrator, created once on an empty database. If ADMIN_PASSWORD is empty a one-time password is
# printed in the backend log. The administrator must change it at first sign-in.
ADMIN_NAME=Administrator
ADMIN_EMAIL=hr@yourcompany.com
ADMIN_PASSWORD=
# Optional: real emails. Leave MAIL_HOST empty to only queue them.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=leaveflow@yourcompany.com
WEB_PORT=80
